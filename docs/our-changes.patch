+
+def _x469_cap_sells(seen, action, market):
+    """FXC's own WHEAT sales capped to the stock FXC sees (so they cannot sell our hidden units ahead of our sale)"""
+    have = int(projected_shed(action, FarmView(seen)).get("WHEAT", 0))
+    out, changed = [], False
+    for o in market:
+        if isinstance(o, list) and len(o) >= 3 and o[1] == "WHEAT":
+            q = max(0, _int(o[2]))
+            if o[0] == "BUY_PRODUCT":
+                have += q
+            elif o[0] == "SELL":
+                k = min(q, max(0, have))
+                have -= k
+                if k < q:
+                    o, changed = ["SELL", "WHEAT", k], True
+        out.append(o)
+    if changed:
+        _X469_REPORT["capped_sells"] += 1
+    return out
+
+
+def _x469_sell(market, h, step):
+    """place the held front-run sale; True if placed"""
+    n = h["held"]
+    if h["mode"] == "sc":
+        k = next((j for j, o in enumerate(market) if isinstance(o, list) and o[:2] == ["BUY_PRODUCT", "WHEAT"]), None)
+        if k is not None and k + 1 < len(market) and isinstance(market[k + 1], list) and market[k + 1][:2] == ["SELL", "WHEAT"] \
+                and len(market[k + 1]) >= 3:
+            market[k + 1] = ["SELL", "WHEAT", _int(market[k + 1][2]) + n]
+            return True
+    if len(market) >= 10:
+        return False
+    market.extend([["SELL", "WHEAT", 0]] * (9 - len(market)) + [["SELL", "WHEAT", n]] if step % 4 == 0 else [["SELL", "WHEAT", n]])
+    return True
+
+
+def v469_market_agent(observation, configuration=None):
+    step, player = int(observation["step"]), int(observation["player"])
+    if step == 0:
+        for k in _X469_REPORT:
+            _X469_REPORT[k] = 0
+        _X469_REPORT["first_fire"] = -1
+    st = _X469_STATE.get(player)
+    if st is None or step <= st["last"]:
+        st = _X469_STATE[player] = dict(last=-1, prev=None, r={}, tw={}, sc=[], h=None, skip=-1, force=-1, room_step=-1, room_less=0)
+    st["last"] = step
+    seen, h = observation, st["h"]
+    try:
+        _x469_observe(observation, st)
+        if h is not None:
+            if "held" not in h:
+                have = int(observation["private"]["shed"].get("WHEAT", 0))
+                alone = h["pre"] + h["pbuy"] - min(h["psell"], h["pre"] + h["pbuy"])
+                h["held"] = max(0, min(h["n"], have - alone))
+                if h["held"] < h["n"]:
+                    _X469_REPORT["underfill"] += 1
+                h["cost"] = h["lone"] * h["held"] / h["n"] if h["n"] else 0.0
+            if h["held"] <= 0:
+                st["h"], h = None, None
+            else:
+                seen = _x466_hide(observation, h)
+                if step % 4 == 0 and h["t"] == step:
+                    if h["mode"] == "sc" and not (_X469_CFG["fr"] and st["r"].get(step - 1, {}).get("WHEAT", 0) >= _X469_FR):
+                        st["force"], st["room_step"], st["room_less"] = step, step, h["held"]
+                    else:
+                        h["mode"] = "tw"
+                        st["skip"] = step
+        elif (step % 4 == 0 and _X469_CFG["fr"] and _X466_LO <= step <= _X466_HI
+              and st["r"].get(step - 1, {}).get("WHEAT", 0) >= _X469_FR):
+            st["skip"] = step
+            _X469_REPORT["fr_skips"] += 1
+            _x469_fire(step)
+    except Exception:
+        _X469_REPORT["errors"] += 1
+        st["h"], h, seen = None, None, observation
+    action = _X469_PARENT(seen, configuration)
+    out = action
+    try:
+        market = [list(o) if isinstance(o, (list, tuple)) else o for o in (action.get("market") or [])]
+        before = [list(o) if isinstance(o, (list, tuple)) else o for o in market]
+        if h is not None:
+            market = _x469_cap_sells(seen, action, market)
+            if _x469_sell(market, h, step):
+                st["h"] = None
+            else:
+                h["left"] -= 1
+                _X469_REPORT["carried"] += 1
+                if h["left"] <= 0:
+                    st["h"] = None
+                    _X469_REPORT["revealed"] += 1
+        elif ((step + 1) % 4 == 0 and _X466_LO <= step + 1 <= _X466_HI and len(market) < 10
+              and (_X466_STATE.get(player) or {}).get("h") is None):
+            mode = _x469_hit(step, st)
+            if mode:
+                m = _x469_size(observation, action, market, step, player)
+                if m >= _X469_MIN:
+                    market.append(["BUY_PRODUCT", "WHEAT", m])
+                    orders = action.get("market") or []
+                    inv = int(observation["market"]["inventory"]["WHEAT"])
+                    st["h"] = dict(t=step + 1, n=m, mode=mode, left=_X469_CARRY,
+                                   lone=sum(_r37_market_price("WHEAT", inv - 1 - j) for j in range(m)),
+                                   pre=int(projected_shed(action, FarmView(observation)).get("WHEAT", 0)),
+                                   pbuy=sum(max(0, _int(o[2])) for o in orders if isinstance(o, list) and o[:2] == ["BUY_PRODUCT", "WHEAT"] and len(o) >= 3),
+                                   psell=sum(max(0, _int(o[2])) for o in orders if isinstance(o, list) and o[:2] == ["SELL", "WHEAT"] and len(o) >= 3))
+                    _X469_REPORT["fronts_tw" if mode == "tw" else "fronts_sc"] += 1
+                    _X469_REPORT["front_units"] += m
+                    _x469_fire(step)
+        if market != before:
+            out = dict(action, market=market)
+    except Exception:
+        _X469_REPORT["errors"] += 1
+        out = action
+    try:
+        st["prev"] = dict(step=step, inv={p: int(observation["market"]["inventory"].get(p, 0)) for p in PRODUCTS},
+                          own=_x469_own(observation, out), shops=list(observation["town"]["unlocked_shops"]),
+                          rmoney=float(observation["farms"][1 - player]["money"]))
+    except Exception:
+        _X469_REPORT["errors"] += 1
+        st["prev"] = None
+    return out
+
+
+v469_market_agent.telemetry = _X469_REPORT
+agent = v469_market_agent
+kaggle_submission_agent = agent
