+        _X467_REPORT["first_fire"] = -1
+    st = _X467_STATE.get(player)
+    if st is None or step <= st["last"]:
+        st = _X467_STATE[player] = dict(last=-1, prev=None, rnb={}, pairs=[])
+    st["last"] = step
+    action = _X467_PARENT(observation, configuration)
+    try:
+        out = action
+        if _X467_CFG["close"] > 0:
