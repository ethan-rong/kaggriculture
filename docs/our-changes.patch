+# ---------------------------------------------------------------------------
+# v467 MARKET layer (2026-09-28, lane v467; results/v467/MECH.md): market orders only, on top of TWSQ (whose code above is
+# unchanged; this layer rebinds two of TWSQ's layer functions in the file's own override pattern and wraps its entry).
+# FIX (MECH b): (1) the stake sort never moves a SELL ahead of a same-step BUY_PRODUCT of the same item (SQ put I2's S1 close
+#   SELL WHEAT 59 before its BUY 59, so the wash was held instead of closed); (2) the tick-wash BUY is never merged into a
+#   BUY_PRODUCT WHEAT that the same step closes (the next order is a SELL WHEAT: S1 / a same-step closer), because a
+#   same-step closer at that index then sells into our held units' price impact; it merges into the first unclosed WHEAT
+#   buy, else goes after the last SELL/BUY_PRODUCT as TWSQ places it. NOSQ arms drop the stake sort.
+# CLOSE (MECH c): while the rival is observed tick-washing (>= 2 of its last 3 tick pairs: net WHEAT buy >= 10 at t % 4 == 0
+#   and net sell >= 10 at t+1, inferred as our net sell - town consumption - the change in market WHEAT inventory), a
+#   fraction of this step's wash is sold right after our wash BUY in the same step (capturing a lockstep rival's impact);
+#   the rest is held across the tick as in TWSQ.
+# When no feature changes the step's orders, TWSQ's action is returned unchanged.
+# ---------------------------------------------------------------------------
+_X467_PARENT = agent
+_X467_CFG = dict(fix=True, sq=True, close=1.0)
+_X467_SQ_BASE = _x466_sq
+_X467_STATE = {}
+_X467_WHEAT_SHOPS = ("BAKERY", "PIZZA_SHOP", "BRUNCH_SPOT", "ICE_CREAM_SHOP", "FARMERS_MARKET")
+_X467_REPORT = dict(fired=0, first_fire=-1, sq_pinned=0, unmerged=0, detected_steps=0, closes=0, close_units=0, errors=0)
+
+
+def _x467_fire(step):
+    _X467_REPORT["fired"] = 1
+    if _X467_REPORT["first_fire"] < 0:
+        _X467_REPORT["first_fire"] = step
+
+
+def _x467_sq(obs, market):
+    if not _X467_CFG["sq"]:
+        return market
+    if not _X467_CFG["fix"]:
+        return _X467_SQ_BASE(obs, market)
+    bought, pinned = set(), set()
+    for k, o in enumerate(market):
+        if isinstance(o, list) and len(o) >= 3:
+            if o[0] == "BUY_PRODUCT":
+                bought.add(o[1])
+            elif o[0] == "SELL" and o[1] in bought:
+                pinned.add(k)
+    if not pinned:
+        return _X467_SQ_BASE(obs, market)
+    masked = [["_PINNED"] if k in pinned else o for k, o in enumerate(market)]
+    out = [market[k] if k in pinned else o for k, o in enumerate(_X467_SQ_BASE(obs, masked))]
+    if out != _X467_SQ_BASE(obs, market):
+        _X467_REPORT["sq_pinned"] += 1
+        _x467_fire(int(obs["step"]))
+    return out
+
+
+def _x467_buy(obs, action, market, step, player):
+    """TWSQ's _x466_buy (SMART) with FIX (2): never merged into a WHEAT buy that the next order closes; records the index"""
+    native = _IMPL.chassis.players.get(player) or {}
+    tape = _IMPL.chassis.routes.get(native.get("route"))
+    if not tape or step + 1 >= len(tape):
+        return None
+    view = FarmView(obs)
+    proj = projected_shed(action, view)
+    n = _x466_room(view, action, proj, _X466_CFG["rival"])
+    if n < _X466_NMIN:
+        return None
+    farm = obs["farms"][player]
+    prices = obs["market"]["prices"]
+    quads = len(farm["unlocked_quadrants"])
+    budget = (float(farm["money"]) - _x466_spend(market, prices, _get(farm, "hires_today", 0), quads)
+              - _x466_spend(tape[step + 1].get("market") or [], prices, 0, quads) - 300)
+    inv = int(obs["market"]["inventory"]["WHEAT"])
+    cost, k = 0.0, 0
+    while k < n:
+        c = _r37_market_price("WHEAT", inv - 1 - 2 * k)
+        if cost + c > budget:
+            break
+        cost, k = cost + c, k + 1
+    if k < _X466_NMIN:
+        _X466_REPORT["skipped_money"] += 1
+        return None
+    n = k
+
+    def is_buy(o):
+        return isinstance(o, list) and o[:2] == ["BUY_PRODUCT", "WHEAT"] and len(o) >= 3
+
+    def closed(j):
+        return (_X467_CFG["fix"] and j + 1 < len(market) and isinstance(market[j + 1], list)
+                and market[j + 1][:2] == ["SELL", "WHEAT"])
+    first = next((j for j, o in enumerate(market) if is_buy(o)), None)
+    j = next((j for j, o in enumerate(market) if is_buy(o) and not closed(j)), None)
+    if first is not None and j != first:
+        _X467_REPORT["unmerged"] += 1
+        _x467_fire(step)
+    if j is not None:
+        market[j] = ["BUY_PRODUCT", "WHEAT", _int(market[j][2]) + n]
+        at = j
+    elif len(market) >= 10:
+        _X466_REPORT["skipped_full"] += 1
+        return None
+    else:
+        last = max((j for j, o in enumerate(market) if isinstance(o, list) and o and o[0] in ("SELL", "BUY_PRODUCT")),
+                   default=-1)
+        market.insert(last + 1, ["BUY_PRODUCT", "WHEAT", n])
+        at = last + 1
+    orders = action.get("market") or []
+    pbuy = sum(max(0, _int(o[2])) for o in orders if isinstance(o, list) and o[:2] == ["BUY_PRODUCT", "WHEAT"] and len(o) >= 3)
+    psell = sum(max(0, _int(o[2])) for o in orders if isinstance(o, list) and o[:2] == ["SELL", "WHEAT"] and len(o) >= 3)
+    lone = sum(_r37_market_price("WHEAT", inv - 1 - i) for i in range(n))
+    _X466_REPORT["washes"] += 1
+    _X466_REPORT["units"] += n
+    return dict(t=step, n=n, lone=lone, pre=int(proj.get("WHEAT", 0)), pbuy=pbuy, psell=psell, left=_X466_CARRY, k=at)
+
+
+_x466_sq = _x467_sq
+if _X466_CFG["tw"] == "SMART":
+    _x466_buy = _x467_buy
+
+
+def _x467_consumed(shops, step):
+    c = 0
+    if step % 4 == 0:
+        c += sum(1 for s in shops if s in _X467_WHEAT_SHOPS)
+    if step % 24 == 0:
+        c += 1
+    return c
+
+
+def _x467_detect(obs, st):
+    """update the rival's inferred net WHEAT buy of the previous step and the tick-pair record; True if tick-washing"""
+    step = int(obs["step"])
+    inv = int(obs["market"]["inventory"]["WHEAT"])
+    prev = st.get("prev")
+    if prev and prev["step"] == step - 1:
+        rival = prev["own_sell"] - prev["own_buy"] - _x467_consumed(prev["shops"], prev["step"]) - (inv - prev["inv"])
+        st["rnb"][prev["step"]] = rival
+        t = prev["step"] - 1
+        if t % 4 == 0 and t in st["rnb"]:
+            st["pairs"].append(st["rnb"][t] >= 10 and rival <= -10)
+            st["pairs"] = st["pairs"][-3:]
+        for old in [x for x in st["rnb"] if x < step - 8]:
+            del st["rnb"][old]
+    return sum(st["pairs"]) >= 2
+
+
+def _x467_record(obs, st, action):
+    market = action.get("market") or []
+    buy = sum(max(0, _int(o[2])) for o in market if isinstance(o, list) and o[:2] == ["BUY_PRODUCT", "WHEAT"] and len(o) >= 3)
+    sell = sum(max(0, _int(o[2])) for o in market if isinstance(o, list) and o[:2] == ["SELL", "WHEAT"] and len(o) >= 3)
+    have = int(obs["private"]["shed"].get("WHEAT", 0))
+    st["prev"] = dict(step=int(obs["step"]), inv=int(obs["market"]["inventory"]["WHEAT"]), own_buy=buy,
+                      own_sell=min(sell, have + buy), shops=list(obs["town"]["unlocked_shops"]))
+
+
+def _x467_close(obs, action, step, player):
+    h = (_X466_STATE.get(player) or {}).get("h")
+    if not h or h.get("t") != step or "held" in h or "k" not in h:
+        return action
+    market = [list(o) if isinstance(o, (list, tuple)) else o for o in (action.get("market") or [])]
+    m = min(h["n"], int(round(h["n"] * _X467_CFG["close"])))
+    k = h["k"]
+    if m <= 0 or len(market) >= 10 or k >= len(market) or market[k][:2] != ["BUY_PRODUCT", "WHEAT"]:
+        return action
+    market.insert(k + 1, ["SELL", "WHEAT", m])
+    left = h["n"] - m
+    if left <= 0:
+        _X466_STATE[player]["h"] = None
+    else:
+        h["lone"] = h["lone"] * left / h["n"]
+        h["n"] = left
+    _X467_REPORT["closes"] += 1
+    _X467_REPORT["close_units"] += m
+    _x467_fire(step)
+    return dict(action, market=market)
+
