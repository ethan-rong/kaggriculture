+
+def _x469_buy(obs, action, market, step, player):
+    """FXC's wash BUY, skipped (tw front-run tick, FR) or with its room reduced by our held front-run units (sc)"""
+    st = _X469_STATE.get(player) or {}
+    if st.get("skip") == step:
+        return None
+    held = st.get("room_less", 0) if st.get("room_step") == step else 0
+    if held <= 0:
+        return _X469_BUY_BASE(obs, action, market, step, player)
+    global _x466_room
+    room = _x466_room
+    _x466_room = lambda view, act, proj, rival: room(view, act, proj, rival) - held
+    try:
+        return _X469_BUY_BASE(obs, action, market, step, player)
+    finally:
