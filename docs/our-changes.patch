+v467_market_agent.telemetry = _X467_REPORT
+agent = v467_market_agent
+kaggle_submission_agent = agent
+# ---------------------------------------------------------------------------
+# v469 FRONT-RUN layer (2026-09-28, lane v469; results/v469/MECH.md): market orders only, on top of FXC (= TWSQ + the v467 layer; its
+# code above is unchanged). It rebinds FXC's wash BUY (_x466_buy) and FXC's rival detector (_x467_detect) in the file's own override
+# pattern and wraps the entry. When no rule acts, FXC's action is returned unchanged.
+# Observables (the engine's own accounting): the rival's net units bought of every product at step u = our net sale of it at u (our
+#   orders; sales capped in queue order by the projected shed + our buys) - the town's consumption of it at u - the change in market
+#   inventory; the rival's money is in the observation.
+# TW event at tick tau: the rival's net WHEAT buy >= 10 at tau and a net sale <= -10 within 2 steps.
+# SC event at tick v: the rival's net flow is 0 in every product and its money rose by >= 10 (a profitable same-step round trip).
+# FRONT ('last': a TW event at t-4; '2of3': at >= 2 of t-4, t-8, t-12; or SC: >= K SC events): at t-1 BUY m WHEAT (TWSQ's room bound
+#   and a lockstep money guard); the m units are hidden from FXC at t (as TWSQ hides its held wash: shed - m, money + cost, market
+#   inventory + m), FXC's own WHEAT sales at t are capped to the stock it sees, and at t:
+#   - after a TW prediction: no own wash at t; SELL m at queue index 9 (the queue padded with SELL WHEAT 0 = empty slots), after the
+#     rival's wash BUY;
+#   - after SC: FXC's same-step close is forced at t and the m units are added to the close SELL right after our wash BUY (FXC's wash
+#     room is reduced by m); without a wash at t the m units go to index 9.
+#   A sale that does not fit (queue full) is carried to the next step, up to 3 steps, still hidden.
+# FR: no own wash at t when the rival net-bought >= 20 WHEAT at t-1 (v468).
+# ---------------------------------------------------------------------------
+_X469_PARENT = agent
+_X469_CFG = dict(front='2of3', fr=True, sc=3)
+_X469_BUY_BASE = _x466_buy
+_X469_DETECT_BASE = _x467_detect
+_X469_SHOPS = {"BAKERY": ("EGG", "WHEAT"), "PIZZA_SHOP": ("MILK", "TOMATO", "WHEAT"), "BRUNCH_SPOT": ("EGG", "WHEAT", "STRAWBERRY"),
+               "YARN_STORE": ("WOOL",), "ICE_CREAM_SHOP": ("STRAWBERRY", "MILK", "WHEAT"), "PET_CAFE": ("CARROT",),
+               "SMOOTHIE_SHOP": ("STRAWBERRY", "MILK"), "FARMERS_MARKET": ("WHEAT", "CARROT", "TOMATO", "STRAWBERRY")}
+_X469_CENTER = ("WHEAT", "CARROT", "TOMATO", "STRAWBERRY", "MELON", "EGG", "MILK", "WOOL")
+_X469_MIN, _X469_FR, _X469_SCM, _X469_CARRY = 10, 20, 10, 3
+_X469_STATE = {}
+_X469_REPORT = dict(fired=0, first_fire=-1, fronts_tw=0, fronts_sc=0, front_units=0, fr_skips=0, tw_events=0, sc_events=0, carried=0,
+                    revealed=0, capped_sells=0, underfill=0, errors=0)
+
+
+def _x469_fire(step):
+    _X469_REPORT["fired"] = 1
+    if _X469_REPORT["first_fire"] < 0:
+        _X469_REPORT["first_fire"] = step
+
+
+def _x469_consumed(shops, step):
+    c = {}
+    if step % 4 == 0:
+        for s in shops:
+            prods = _X469_SHOPS.get(s, ())
+            for p in prods:
+                c[p] = c.get(p, 0) + (2 if len(prods) == 1 else 1)
+    if step % 24 == 0:
+        for p in _X469_CENTER:
+            c[p] = c.get(p, 0) + 1
+    return c
+
+
+def _x469_own(obs, action):
+    """our net units bought per product in this step's final orders (buys assumed filled, sales capped by the stock in queue order)"""
+    shed = dict(projected_shed(action, FarmView(obs)))
+    net = {}
+    for o in action.get("market") or []:
+        if isinstance(o, list) and len(o) >= 3 and o[1] in PRODUCTS and o[0] in ("BUY_PRODUCT", "SELL"):
+            q = max(0, _int(o[2]))
+            if o[0] == "BUY_PRODUCT":
+                shed[o[1]] = int(shed.get(o[1], 0)) + q
+                net[o[1]] = net.get(o[1], 0) + q
+            else:
+                k = min(q, max(0, int(shed.get(o[1], 0))))
+                shed[o[1]] = int(shed.get(o[1], 0)) - k
+                net[o[1]] = net.get(o[1], 0) - k
+    return net
+
+
+def _x469_observe(obs, st):
+    """the rival's net flows and money change of the previous step; TW and SC events now observable"""
+    step, player = int(obs["step"]), int(obs["player"])
+    prev = st.get("prev")
+    if prev and prev["step"] == step - 1:
+        inv = obs["market"]["inventory"]
+        cons = _x469_consumed(prev["shops"], step - 1)
+        flows = {}
+        for p in PRODUCTS:
+            r = -prev["own"].get(p, 0) - cons.get(p, 0) - (int(inv.get(p, 0)) - int(prev["inv"].get(p, 0)))
+            if r:
+                flows[p] = r
+        st["r"][step - 1] = flows
+        dm = float(obs["farms"][1 - player]["money"]) - prev["rmoney"]
+        v = step - 1
+        if v % 4 == 0 and v >= _X466_LO and not flows and dm >= _X469_SCM:
+            st["sc"].append(v)
+            _X469_REPORT["sc_events"] += 1
+    r = st["r"]
+    for tau in [x for x in range(step - 3, step - 1) if x % 4 == 0 and x not in st["tw"]]:
+        b0, b1, b2 = (r.get(tau, {}).get("WHEAT", 0), r.get(tau + 1, {}).get("WHEAT", 0), r.get(tau + 2, {}).get("WHEAT", 0))
+        if b0 >= _X469_MIN and tau + 2 < step and min(b1, b2) <= -_X469_MIN:
+            st["tw"][tau] = b0
+            _X469_REPORT["tw_events"] += 1
+    for old in [x for x in r if x < step - 16]:
+        del r[old]
+
+
+def _x469_hit(step, st):
+    """at step t-1: the front-run mode for the tick t = step + 1 ('tw', 'sc' or None)"""
+    t = step + 1
+    f = _X469_CFG["front"]
+    if f == "last" and (t - 4) in st["tw"]:
+        return "tw"
+    if f == "2of3" and sum((t - 4 * k) in st["tw"] for k in (1, 2, 3)) >= 2:
+        return "tw"
+    if _X469_CFG["sc"] and len(st["sc"]) >= _X469_CFG["sc"]:
+        return "sc"
+    return None
