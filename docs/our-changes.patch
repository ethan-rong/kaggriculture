+
+def _pf_trigger(queue, pos, tile, command, step):
+    """The build _weed_repair queued after a weed DIG is about to be lost: the unit still stands on the queued
+    tile, the tile is empty again, it is the same day, and the unit's command this step is not that build."""
+    return (bool(queue) and step % 24 != 0 and tile is None and queue[0][0] == pos
+            and bool(queue[0][1]) and queue[0][1][0] in _PF_OPS and command != queue[0][1])
+
+
+def _pf_weed_repair(self, action, view, st, route, step):
+    _PF_WEED_REPAIR(self, action, view, st, route, step)
+    lag = st.get("pf_lag")
+    if not lag and not st["pending"]:
+        return
+    try:
+        units = [action.get("farmer") or ["PASS"]] + list(action.get("hands") or [])
+        n = min(len(units), len(view.positions))
+        new, keep, drop, fired = list(units), set(lag or ()), set(), set()
+        if keep and step % 24 == 0:
+            keep = set()                                  # new day: hands re-hired, farmer respawned
+        if keep:
+            prev = self._route_action(route, step - 1)
+            tape = [prev.get("farmer") or ["PASS"]] + list(prev.get("hands") or [])
+            for i in sorted(keep):
+                late = tape[i] if i < len(tape) and tape[i] else ["PASS"]
+                if i >= n or late[0] == "PASS":
+                    keep.discard(i)                       # drop the delayed PASS: back on the tape
+                else:
+                    new[i] = list(late)
+                    drop.add(i)
+        for i in range(n):
+            if i in keep:
+                continue
+            p = view.positions[i]
+            if not isinstance(p, (list, tuple)):
+                continue
+            pos = (int(p[0]), int(p[1]))
+            queue = st["pending"].get(i)
+            if _pf_trigger(queue, pos, _tile_at(view.tiles, pos), units[i], step):
+                new[i] = list(queue[0][1])
+                fired.add(i)
+                drop.add(i)
+        if lag is None and not fired:
+            return
+        for i in drop:
+            st["pending"].pop(i, None)                    # queues built against the lagged unit's tape are stale
+        st["pf_lag"] = keep | fired
+        if new != units:
+            action["farmer"] = new[0]
+            action["hands"] = new[1:]
+    except Exception:
+        pass
 
 
